NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Barnes Hauling and Disposal <updates@mail.your-production-domain.example>
RESEND_REPLY_TO_EMAIL=barneshaulingdisposal@gmail.com
RESEND_CONTACT_TO_EMAIL=barneshaulingdisposal@gmail.com
RESEND_BOOKING_TO_EMAIL=barneshaulingdisposal@gmail.com
RESEND_WEBHOOK_SECRET=whsec_your_webhook_secret

# Google Maps (public, referrer-restricted browser key). Enable the Maps
# JavaScript API and Geocoding API for this key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key

# Stripe (server-only). Use test keys until pricing is finalized and legally
# reviewed. STRIPE_WEBHOOK_SECRET comes from `stripe listen` or the dashboard
# webhook endpoint.
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Cloudflare Turnstile (optional; server-side spam check enforces when set).
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# ---------------------------------------------------------------------------
# Developer tooling only. NOT read by the app at runtime.
# ---------------------------------------------------------------------------
# Stripe MCP server (.mcp.json). This must be EXPORTED IN YOUR SHELL — it is
# not loaded from .env.local, because the MCP server is spawned by the editor
# rather than by Next.js. Use a RESTRICTED test-mode key (rk_test_...), never
# the sk_ secret key: the MCP server's tool permissions are defined entirely by
# what that key is scoped to.
#   export STRIPE_MCP_RESTRICTED_KEY=rk_test_your_restricted_key

